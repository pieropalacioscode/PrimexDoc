cat << 'EOF' > .gitignore
# Variables de entorno (¡Crítico no subir contraseñas!)
.env
.env.local
.env.*

# Frontend (Node.js / Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*

# Backend (Go / Binarios compilados)
backend/primexdoc-api
backend/*.exe
backend/*.out
backend/bin/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
EOF